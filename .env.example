APP_NAME="Mutual Loan Fund"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

# --- Docker -------------------------------------------------------------------
# Host port the application is published on.
HTTP_PORT=8080
# Host port PostgreSQL is published on.
DB_PORT_HOST=5432
# uid/gid of the server user that owns this checkout (run `id -u` / `id -g`).
APP_UID=1000
APP_GID=1000
# Run migrations automatically when the app container boots.
AUTO_MIGRATE=true

# --- Database -----------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=mutual_loan_fund
DB_USERNAME=mlf
DB_PASSWORD=mlf_secret

# --- Session / cache / queue --------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

# --- Blockchain verification --------------------------------------------------
# manual  : the server records the claimed hash; an administrator verifies it.
# trongrid: the server queries TronGrid to verify TRC-20 transfers.
BLOCKCHAIN_VERIFIER=manual
TRONGRID_ENDPOINT=https://api.trongrid.io
TRONGRID_API_KEY=
BLOCKCHAIN_MIN_CONFIRMATIONS=19

# --- Financial defaults -------------------------------------------------------
# Valuation unit shown across the UI. Do not change without a data migration.
GOLD_UNIT=XAU18G
DEFAULT_FUNCTIONAL_CURRENCY=IRT
