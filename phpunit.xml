<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The containers inject the production .env into the environment
             (docker compose env_file), so tests/bootstrap.php forces these
             values into $_ENV/$_SERVER/getenv before the app boots. -->
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="mutual_loan_fund_test"/>
        <!--
            The suite operates USDT funds. A fund whose functional currency is
            its treasury's currency needs no exchange rate to post, so the tests
            that are about accounting are not entangled with rate availability.
            The tests that are about rates set their own functional currency.
        -->
        <env name="DEFAULT_FUNCTIONAL_CURRENCY" value="USDT"/>
        <env name="BLOCKCHAIN_VERIFIER" value="manual"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
